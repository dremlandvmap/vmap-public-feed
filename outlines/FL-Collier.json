{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">FLORIDA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Collier County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">417,000 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Naples</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">1,997 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">209 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$90,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$540,000</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Collier County is Florida's second-largest county by land area and one of its wealthiest, running from the luxury coastal market of Naples and Marco Island east across Golden Gate Estates to the agricultural community of Immokalee and the Everglades. Most of the county is conservation or rural land, so growth concentrates in a narrow coastal band and the eastern rural-lands villages — making boundary and land-use context essential.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: September 7, 2026</div></div>"],"feats":[["Collier County",0,[[25.80248,-81.62488],[25.80079,-81.84821],[25.80242,-81.84923],[25.80392,-81.84999],[25.80546,-81.85064],[25.80785,-81.85302],[25.80988,-81.85497],[25.81195,-81.85689],[25.81404,-81.85876],[25.81831,-81.86238],[25.8227,-81.86584],[25.82494,-81.8675],[25.8272,-81.86912],[25.82948,-81.8707],[25.83412,-81.87372],[25.83884,-81.87655],[25.84132,-81.87793],[25.84368,-81.8792],[25.84612,-81.88046],[25.84859,-81.88167],[25.85105,-81.88283],[25.85356,-81.88395],[25.85607,-81.88502],[25.85861,-81.88603],[25.86115,-81.887],[25.86371,-81.88792],[25.86629,-81.88879],[25.86888,-81.88961],[25.87148,-81.89038],[25.87439,-81.89338],[25.87544,-81.8944],[25.87762,-81.89583],[25.88157,-81.89827],[25.88429,-81.89986],[25.88738,-81.90156],[25.89083,-81.90336],[25.89415,-81.90498],[25.89617,-81.9059],[25.9004,-81.90773],[25.90399,-81.90916],[25.90727,-81.91037],[25.91022,-81.91137],[25.91249,-81.9121],[25.91442,-81.91268],[25.91918,-81.91399],[25.92202,-81.91469],[25.92398,-81.91513],[25.92737,-81.91583],[25.93201,-81.91664],[25.93561,-81.91715],[25.94083,-81.91773],[25.94426,-81.91799],[25.94733,-81.91816],[25.9504,-81.91826],[25.95273,-81.91843],[25.95442,-81.91919],[25.95713,-81.92034],[25.96039,-81.92164],[25.96488,-81.92329],[25.9721,-81.92578],[25.98427,-81.93258],[25.98784,-81.93447],[25.99637,-81.93883],[26.00116,-81.94116],[26.00778,-81.94421],[26.01012,-81.94522],[26.01349,-81.9466],[26.01663,-81.9478],[26.01854,-81.949],[26.02029,-81.95005],[26.02531,-81.95289],[26.02794,-81.95427],[26.03109,-81.95583],[26.03478,-81.95756],[26.038,-81.95896],[26.04142,-81.96034],[26.04521,-81.96175],[26.04973,-81.96328],[26.053