{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">FLORIDA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Collier County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">417,000 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Naples</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">1,997 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">209 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$90,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$540,000</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Collier County is Florida's second-largest county by land area and one of its wealthiest, running from the luxury coastal market of Naples and Marco Island east across Golden Gate Estates to the agricultural community of Immokalee and the Everglades. Most of the county is conservation or rural land, so growth concentrates in a narrow coastal band and the eastern rural-lands villages — making boundary and land-use context essential.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: August 21, 2026</div></div>"],"feats":[["Collier County",0,[[26.25945,-80.87984],[26.25879,-80.91114],[26.25777,-80.95252],[26.2571,-80.99979],[26.25681,-81.00198],[26.25692,-81.00777],[26.25683,-81.02628],[26.25629,-81.08686],[26.25614,-81.09821],[26.25602,-81.1068],[26.2553,-81.12479],[26.25461,-81.16448],[26.25452,-81.16717],[26.25446,-81.17161],[26.25443,-81.17167],[26.25434,-81.17859],[26.2542,-81.18912],[26.25438,-81.20269],[26.2541,-81.21983],[26.25331,-81.24979],[26.25305,-81.26855],[26.26458,-81.26852],[26.29667,-81.2696],[26.3155,-81.26979],[26.32309,-81.26991],[26.34695,-81.27018],[26.36778,-81.27075],[26.37004,-81.27074],[26.37536,-81.27081],[26.37536,-81.27084],[26.39587,-81.27126],[26.39772,-81.27125],[26.42252,-81.27172],[26.4365,-81.27172],[26.44867,-81.27166],[26.45196,-81.2717],[26.45253,-81.27164],[26.4575,-81.27167],[26.46678,-81.27187],[26.48436,-81.27175],[26.49384,-81.27177],[26.50027,-81.27182],[26.51707,-81.27176],[26.51621,-81.36997],[26.51621,-81.3747],[26.51652,-81.39237],[26.51627,-81.41788],[26.51602,-81.42355],[26.51554,-81.43342],[26.51549,-81.43813],[26.51548,-81.44444],[26.51483,-81.45248],[26.51485,-81.45559],[26.5137,-81.46633],[26.51367,-81.46633],[26.51333,-81.47042],[26.51347,-81.48154],[26.51357,-81.4854],[26.51344,-81.4998],[26.51333,-81.54444],[26.51336,-81.54505],[26.51332,-81.56376],[26.47326,-81.56307],[26.47294,-81.56313],[26.46619,-81.56301],[26.45035,-81.56264],[26.42316,-81.56221],[26.42263,-81.56218],[26.42258,-81.56751],[26.42184,-81.61377],[26.42169,-81.6248],[26.42132,-81.64336],[26.42129,-81.64782],[26.42108,-81.6595],[26.37536,-81.65855],[26.36273,-81.65839],[26.31756,-81.6579],[26.31754,-81.66772],[26.317