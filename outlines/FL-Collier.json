{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">FLORIDA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Collier County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">417,000 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Naples</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">1,997 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">209 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$90,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$540,000</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Collier County is Florida's second-largest county by land area and one of its wealthiest, running from the luxury coastal market of Naples and Marco Island east across Golden Gate Estates to the agricultural community of Immokalee and the Everglades. Most of the county is conservation or rural land, so growth concentrates in a narrow coastal band and the eastern rural-lands villages — making boundary and land-use context essential.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: November 2, 2026</div></div>"],"feats":[["Collier County",0,[[26.33037,-81.84614],[26.3304,-81.84491],[26.33035,-81.84385],[26.33035,-81.8411],[26.3303,-81.83946],[26.33029,-81.83737],[26.3303,-81.83578],[26.33037,-81.83364],[26.33042,-81.81912],[26.31624,-81.81902],[26.31629,-81.80517],[26.31624,-81.80095],[26.31628,-81.78914],[26.31631,-81.78869],[26.31644,-81.78801],[26.31634,-81.78623],[26.31637,-81.78296],[26.31663,-81.76254],[26.31689,-81.74717],[26.31698,-81.73474],[26.31685,-81.73386],[26.31687,-81.73215],[26.317,-81.73008],[26.31704,-81.72785],[26.31739,-81.682],[26.31753,-81.66772],[26.31756,-81.6579],[26.36273,-81.65839],[26.37536,-81.65856],[26.42108,-81.65951],[26.42129,-81.64782],[26.42132,-81.64336],[26.42169,-81.6248],[26.42184,-81.61378],[26.42257,-81.56752],[26.42263,-81.56218],[26.42316,-81.56222],[26.45034,-81.56265],[26.46619,-81.56301],[26.47294,-81.56313],[26.47326,-81.56307],[26.51333,-81.56376],[26.51349,-81.5473],[26.51356,-81.531],[26.51372,-81.51485],[26.51365,-81.4987],[26.51354,-81.48252],[26.51384,-81.46627],[26.51548,-81.45133],[26.51559,-81.43512],[26.51621,-81.37275],[26.51622,-81.36829],[26.51707,-81.27177],[26.50027,-81.27182],[26.49385,-81.27177],[26.48436,-81.27176],[26.46678,-81.27187],[26.46334,-81.2718],[26.45956,-81.272],[26.45865,-81.272],[26.45818,-81.27207],[26.45792,-81.27196],[26.45762,-81.27195],[26.4524,-81.27195],[26.4494,-81.272],[26.44539,-81.27196],[26.43947,-81.27196],[26.42752,-81.27201],[26.42265,-81.27193],[26.42101,-81.272],[26.41171,-81.27182],[26.39539,-81.27137],[26.36466,-81.27101],[26.35017,-81.27079],[26.33391,-81.27003],[26.28219,-81.26868],[26.25307,-81.26824],[26.25354,-81.2526],[26.25386,-81.2