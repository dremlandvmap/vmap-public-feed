{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">VIRGINIA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Charlottesville City</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">44,388 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Charlottesville</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">10 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">4,439 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$69,829</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$448,400</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Charlottesville is an independent city, separate from surrounding Albemarle County with its own zoning, schools and tax base, and the University of Virginia along with UVA Health dominates employment, student housing dem