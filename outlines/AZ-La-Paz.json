{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">ARIZONA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">La Paz County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">16,711 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Parker</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">4,497 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">4 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$49,500</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$135,800</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">La Paz County sits on the Colorado River along the California line, with about 16,700 year-round residents over 4,497 square miles. Parker, the county seat, and the river corridor support waterfront and recreational property, while Quartzsite draws a very large seasonal winter influx of RV and snowbird visitors on federal long-term visitor areas — so the functional population and the resident count diverge sharply by season. Irrigated agriculture along the river is the other significant land use, and the Colorado River Indian Tribes reservation covers a substantial share of the county. Median home value is $135,800 against median household income of $49,500.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: August 30, 2026</div></div>"],"feats":[["La Paz",0,[[33.30404,-114.73122],[33.30575,-114.7299],[33.30827,-114.72648],[33.3101,-114.72467],[33.31211,-114.72362],[33.31274,-114.72275],[33.31407,-114.72101],[33.31576,-114.71861],[33.31666,-114.71706],[33.31882,-114.71302],[33.32046,-114.71068],[33.32114,-114.7098],[33.32332,-114.70787],[33.32771,-114.70519],[33.33371,-114.70236],[33.33701,-114.70094],[33.34105,-114.7001],[33.34569,-114.69935],[33.34926,-114.69912],[33.35244,-114.69804],[33.35657,-114.69817],[33.36115,-114.69906],[33.36371,-114.70036],[33.36713,-114.70196],[33.37124,-114.7042],[33.37326,-114.70557],[33.37503,-114.70672],[33.37663,-114.70735],[33.37756,-114.70754],[33.37837,-114.70749],[33.37951,-114.70707],[33.38063,-114.70701],[33.38137,-114.70702],[33.38254,-114.70731],[33.38414,-114.70841],[33.3856,-114.71034],[33.3879,-114.71319],[33.38826,-114.7136],[33.39072,-114.71562],[33.3934,-114.71807],[33.39491,-114.71927],[33.39691,-114.72123],[33.39878,-114.72287],[33.40042,-114.72425],[33.40214,-114.72515],[33.40234,-114.72529],[33.40405,-114.72553],[33.40505,-114.72528],[33.40653,-114.72383],[33.40738,-114.7222],[33.40789,-114.72007],[33.4079,-114.7177],[33.40769,-114.71582],[33.40727,-114.7134],[33.40725,-114.71088],[33.40792,-114.70594],[33.408,-114.70448],[33.40815,-114.70284],[33.40838,-114.70179],[33.40951,-114.69964],[33.41045,-114.69822],[33.41094,-114.69771],[33.41209,-114.6968],[33.41268,-114.69667],[33.41406,-114.69