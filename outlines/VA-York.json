 employment. Growth is residential and retail along Route 17 and the I-64 corridor through Grafton and Tabb, constrained by the federal reservations, waterfront and Chesapeake Bay Preservation Act limits.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: September 24, 2026</div></div>"],"feats":[["York County",0,[[37.35433,-76.75548],[37.35422,-76.75551],[37.35379,-76.7554],[37.3535,-76.75526],[37.35348,-76.75521],[37.35301,-76.75499],[37.3526,-76.75485],[37.35241,-76.75482],[37.35138,-76.75497],[37.35114,-76.75494],[37.35058,-76.75465],[37.35036,-76.75462],[37.35013,-76.75465],[37.34979,-76.75478],[37.34959,-76.75482],[37.34946,-76.75476],[37.34936,-76.75463],[37.34929,-76.75448],[37.34916,-76.75401],[37.34902,-76.75368],[37.34892,-76.75351],[37.34875,-76.75332],[37.34858,-76.75327],[37.3484,-76.75327],[37.34792,-76.75342],[37.34705,-76.75355],[37.34677,-76.75348],[37.34636,-76.75313],[37.34591,-76.75301],[37.34577,-76.75301],[37.34544,-76.75339],[37.34463,-76.7537],[37.3439,-76.75388],[37.34357,-76.75379],[37.34303,-76.75355],[37.34038,-76.75443],[37.34023,-76.75431],[37.34015,-76.75454],[37.33867,-76.75307],[37.3387,-76.75298],[37.33825,-76.75244],[37.33811,-76.75111],[37.33803,-76.75075],[37.33775,-76.75028],[37.33759,-76.75007],[37.3376,-76.7492],[37.33707,-76.74798],[37.33685,-76.74718],[37.3366,-76.74642],[37.33615,-76.74549],[37.33568,-76.74469],[37.33544,-76.74418],[37.33396,-76.73997],[37.33314,-76.73819],[37.33292,-76.7372],[37.33259,-76.73632],[37.33228,-76.73565],[37.33211,-76.73539],[37.33189,-76.73496],[37.33163,-76.73464],[37.33133,-76.73455],[37.3308,-76.73449],[37.32976,-76.73456],[37.32952,-76.73462],[37.32934,-76.73473],[37.32801,-76.73526],[37.32718,-76.73554],[37.32694,-76.73557],[37.32654,-76.73551],[37.32595,-76.73552],[37.32496,-76.73582],[37.32441,-76.73591],[37.32344,-76.73595],[37.32304,-76.73589],[37.32269,-76.73577],[37.32238,-76.73561],[37.32036,-76.73436],[37.31982,-76.73419]