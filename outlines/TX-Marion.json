{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">TEXAS</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Marion County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">9,700 (2023 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Jefferson</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">381 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">25 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$50,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$101,500</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Marion County is anchored by Jefferson, a well-preserved 19th-century steamboat town whose riverboat-era architecture drives a heritage-tourism, antiques and bed-and-breakfast trade found in few other rural Texas counties. Caddo Lake's cypress-lined shoreline forms much of the county's eastern edge, supporting fishing and recreation alongside a timber economy typical of the piney woods. Median household income of about $50,000 and home values near $101,500 reflect a small, slow-growing population under 10,000.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: November 8, 2026</div></div>"],"feats":[["Marion County",0,[[32.87048,-94.70971],[32.86989,-94.70933],[32.87045,-94.70869],[32.87108,-94.70787],[32.87084,-94.70741],[32.8699,-94.70733],[32.86921,-94.70704],[32.86879,-94.70751],[32.8683,-94.70757],[32.86742,-94.70683],[32.86401,-94.70636],[32.86138,-94.70632],[32.86062,-94.70545],[32.86126,-94.70439],[32.86065,-94.70304],[32.86124,-94.70266],[32.86175,-94.7034],[32.86236,-94.70269],[32.86264,-94.7023],[32.86266,-94.70181],[32.86223,-94.70132],[32.86195,-94.70111],[32.8619,-94.7009],[32.8621,-94.70061],[32.86217,-94.70036],[32.86194,-94.69999],[32.86016,-94.69833],[32.85916,-94.69802],[32.8588,-94.69865],[32.85832,-94.69893],[32.85699,-94.6983],[32.85668,-94.69833],[32.85631,-94.69927],[32.85609,-94.69974],[32.85493,-94.69972],[32.85467,-94.69991],[32.8541,-94.69976],[32.85301,-94.69972],[32.85221,-94.70011],[32.85142,-94.70022],[32.84961,-94.70007],[32.84886,-94.6997],[32.84805,-94.6981],[32.84721,-94.69791],[32.847,-94.69865],[32.84642,-94.69892],[32.84554,-94.69891],[32.84506,-94.69898],[32.84447,-94.69856],[32.8441,-94.69792],[32.84341,-94.69788],[32.84308,-94.69766],[32.8431,-94.69708],[32.84351,-94.69608],[32.84357,-94.69496],[32.84306,-94.6906],[32.84276,-94.6871],[32.84217,-94.68668],[32.84214,-94.68669],[32.84137,-94.68704],[32.84099,-94.68804],[32.83991,-94.6889],[32.83906,-94.68867],[32.83801,-94.68611],[32.83879,-94.68579],[32.8394,-94.68619],[32.84016,-94.68627],[32.84069,-94.68506],[32.84072,-94.68408],[32.8411,-94.6832],[32.84085,-94.68244],[32.84022,-94.68165],[32.83917,-94.68219],[32.83843,-94.68279],[32.83749,-94.6823],[