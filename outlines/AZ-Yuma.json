{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">ARIZONA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Yuma County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">224,000 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Yuma</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">5,514 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">41 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$62,900</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$217,800</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Yuma County anchors Arizona's southwestern corner along the Colorado River and the Mexican border, with about 224,000 year-round residents concentrated in Yuma, San Luis and Somerton. Its economy is led by irrigated winter-vegetable agriculture — the county supplies a large share of North America's leafy greens between November and March — together with the Marine Corps Air Station Yuma and the Army's Yuma Proving Ground. The housing market is shaped by a substantial seasonal population that winters in the Foothills and surrounding RV and manufactured-home communities, and by cross-border commerce at the San Luis port of entry. Median home values remain the lowest of Arizona's larger counties.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: August 21, 2026</div></div>"],"feats":[["Yuma",0,[[33.37743,-113.33377],[33.36374,-113.3339],[33.32749,-113.33384],[33.32024,-113.33387],[33.30937,-113.33386],[33.30937,-113.33378],[33.26223,-113.33372],[33.24771,-113.33389],[33.1315,-113.33385],[33.11739,-113.33376],[33.10985,-113.33376],[33.1026,-113.33382],[33.08794,-113.33388],[33.03002,-113.33381],[33.00081,-113.33368],[32.99359,-113.33354],[32.97176,-113.33369],[32.94254,-113.33381],[32.91342,-113.33373],[32.87696,-113.33369],[32.86974,-113.33382],[32.85516,-113.33385],[32.83811,-113.33381],[32.81083,-113.33385],[32.79627,-113.33369],[32.76723,-113.33358],[32.75328,-113.33363],[32.75006,-113.33369],[32.75006,-113.33383],[32.73895,-113.33387],[32.69465,-113.3339],[32.67866,-113.33395],[32.66405,-113.33391],[32.62507,-113.33395],[32.62507,-113.33382],[32.60944,-113.33387],[32.59556,-113.33378],[32.56281,-113.33378],[32.5498,-113.33375],[32.53358,-113.33378],[32.51954,-113.3337],[32.50522,-113.33366],[32.50522,-113.33392],[32.50007,-113.33395],[32.50007,-113.33359],[32.37507,-113.33375],[32.37508,-113.33372],[32.37461,-113.33372],[32.33115,-113.33383],[32.25879,-113.33384],[32.1278,-113.33396],[32.12508,-113.33397],[32.12508,-113.3342],[32.03887,-113.33422],[32.04194,-113.34388],[32.05121,-113.3734],[32.05483,-113.38543],[32.06222,-113.40803],[32.06716,-113.42453],[32.07004,-113.43317],[32.0755,-113.45079],[32.08082,-113.46778],[32.08567,-113.48242],[