{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">TEXAS</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Colorado County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">21,000 (2023 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Columbus</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">960 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">22 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$66,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$209,800</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Colorado County sits on I-10 between Houston and San Antonio, centred on the historic river town of Columbus. Rice farming and cattle ranching share the Colorado River bottomland with oil and gas leasing along the Austin Chalk trend, and Houston commuter growth is pushing rural residential demand westward along the interstate. Median household income runs about $66,000 against a median home value near $209,800.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: September 28, 2026</div></div>"],"feats":[["Colorado County",0,[[29.41157,-96.34736],[29.44995,-96.33244],[29.46412,-96.32708],[29.5001,-96.31336],[29.50024,-96.31331],[29.50024,-96.3132],[29.51452,-96.30767],[29.52469,-96.29644],[29.52487,-96.29617],[29.52516,-96.29583],[29.52588,-96.29507],[29.53014,-96.2903],[29.53546,-96.28451],[29.53946,-96.28008],[29.55848,-96.25893],[29.5641,-96.25281],[29.57229,-96.24376],[29.57439,-96.24123],[29.57546,-96.24],[29.58524,-96.22918],[29.58851,-96.22581],[29.59293,-96.22093],[29.59846,-96.21473],[29.60652,-96.20578],[29.60684,-96.20546],[29.60737,-96.20505],[29.60764,-96.2049],[29.61152,-96.20052],[29.61927,-96.19165],[29.62449,-96.18582],[29.63342,-96.176],[29.63381,-96.17542],[29.63415,-96.17575],[29.63451,-96.17621],[29.63464,-96.17655],[29.63489,-96.17698],[29.63539,-96.1776],[29.63616,-96.17834],[29.63659,-96.17866],[29.63747,-96.1791],[29.63798,-96.1791],[29.6383,-96.17916],[29.63928,-96.1795],[29.63996,-96.17998],[29.6409,-96.18081],[29.64124,-96.1812],[29.64157,-96.18195],[29.64187,-96.18284],[29.64202,-96.1836],[29.64196,-96.18441],[29.64204,-96.18504],[29.64207,-96.18582],[29.64232,-96.18715],[29.64256,-96.18782],[29.64289,-96.1883],[29.64305,-96.18846],[29.64368,-96.18872],[29.64433,-96.18937],[29.64469,-96.18956],[29.64547,-96.18942],[29.64627,-96.18968],[29.64644,-96.18962],[29.64665,-96.18963],[29.64757,-96.18998],[29.64774,-96.19018],[29.64785,-96.19057],[29.64812,-96.1908],[29.64849,-96.19104],[29.64867,-96.19124],[29.64876,-96.19142],[29.64889,-96.192],[29.64995,-96.19379],[29.65003,-96.19386],[29.65048,-96.19398],[29.6507,-96.19424],[29.65128,-96.19463],[29.65184,-96.19479],[29.65288,-96.1952],[29.65352,-96.19562],[29.65416,-96