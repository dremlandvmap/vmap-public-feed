{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">VIRGINIA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Arlington County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">243,931 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Arlington</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">26 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">9,382 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$140,160</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$864,800</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Arlington is a fully urbanized 26-square-mile county directly across the Potomac from Washington, anchored by the Pentagon, a dense federal and defense-contractor tenant base, and Amazon's HQ2 at National Landing, with Reagan National Airport and the Rosslyn-Ballston Metro corridor structuring where density goes. There is no greenfield left, so every project is redevelopment governed by sector plans and site-plan bonus density, and the real market question is absorbing older office stock that federal downsizing and remote work have left behind.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: November 8, 2026</div></div>"],"feats":[["Arlington County",0,[[38.89325,-77.17228],[38.88905,-77.16693],[38.88861,-77.16632],[38.88821,-77.16586],[38.87885,-77.15384],[38.87679,-77.15129],[38.87619,-77.15033],[38.87529,-77.14928],[38.8748,-77.14855],[38.87447,-77.14812],[38.87361,-77.14713],[38.87064,-77.14335],[38.85956,-77.12908],[38.8574,-77.12625],[38.85704,-77.12587],[38.85691,-77.12562],[38.85601,-77.12444],[38.85428,-77.12239],[38.85216,-77.11959],[38.85017,-77.11718],[38.84977,-77.11656],[38.84855,-77.11501],[38.8481,-77.11431],[38.84738,-77.11337],[38.84727,-77.11333],[38.8448,-77.11018],[38.84352,-77.1106],[38.84345,-77.1108],[38.8434,-77.1106],[38.84276,-77.10912],[38.84276,-77.10901],[38.84209,-77.10797],[38.84223,-77.10775],[38.84244,-77.10693],[38.84167,-77.10661],[38.84145,-77.10701],[38.84138,-77.10703],[38.8404,-77.10606],[38.84034,-77.1062],[38.84008,-77.10596],[38.84081,-77.10502],[38.84042,-77.10452],[38.84027,-77.10443],[38.84024,-77.10438],[38.83951,-77.1028],[38.83936,-77.1028],[38.83908,-77.10271],[38.83885,-77.10259],[38.83846,-77.10229],[38.83717,-77.1004],[38.83722,-77.10025],[38.83721,-77.10013],[38.83712,-77.10001],[38.83694,-77.10002],[38.83686,-77.10016],[38.83687,-77.10032],[38.83634,-77.10072],[38.83499,-77.09803],[38.83461,-77.09738],[38.83349,-77.09571],[38.83119,-77.09273],[38.8292,-77.0903],[38.82736,-77.08781],[38.82766,-77.08729],[38.82811,-77.08673],[38.82834,-77.08653],[38.8287,-77.08628],[38.82988,-77.08565],[38.83026,-77.08547],[38.83068,-77.08535],[38.83106,-77.08531],[38.83461,-77.08543],[38.8350