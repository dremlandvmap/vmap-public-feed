{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">TEXAS</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Dallas County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">2,656,000 (2024 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Dallas</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">873 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">3,042 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$77,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$305,000</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Dallas County is the urban core of North Texas, taking in Dallas itself plus inner-ring cities like Irving, Garland and Mesquite. With little raw land left, the market runs on redevelopment — infill, adaptive reuse and transit-oriented projects — so zoning, planned-development districts and school attendance zones matter more here than anywhere else in the metro.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: September 12, 2026</div></div>"],"feats":[["Dallas County",0,[[32.55441,-97.03859],[32.55926,-97.0385],[32.56004,-97.03852],[32.63096,-97.03731],[32.63361,-97.0373],[32.66142,-97.03679],[32.663,-97.03679],[32.73335,-97.03563],[32.74466,-97.03542],[32.75494,-97.03527],[32.75726,-97.03518],[32.76306,-97.03515],[32.76454,-97.03517],[32.76537,-97.03511],[32.7676,-97.0351],[32.77269,-97.03509],[32.77389,-97.03513],[32.77993,-97.03493],[32.78183,-97.0349],[32.7829,-97.0348],[32.79304,-97.03465],[32.80331,-97.0344],[32.80516,-97.03444],[32.83853,-97.03384],[32.86219,-97.03341],[32.87657,-97.0331],[32.87922,-97.03309],[32.97273,-97.03139],[32.98969,-97.03101],[32.98967,-97.02885],[32.98961,-97.02834],[32.98933,-97.00253],[32.98929,-96.98773],[32.98918,-96.97589],[32.98912,-96.97562],[32.98915,-96.97377],[32.98901,-96.95866],[32.98879,-96.9415],[32.98882,-96.93899],[32.98863,-96.93201],[32.98842,-96.92033],[32.98835,-96.91322],[32.98835,-96.91],[32.98809,-96.89646],[32.98801,-96.88791],[32.98797,-96.88624],[32.98795,-96.88628],[32.98797,-96.88599],[32.98683,-96.79664],[32.98566,-96.70973],[32.98548,-96.70548],[32.98555,-96.70476],[32.9855,-96.70197],[32.98542,-96.70124],[32.98528,-96.69534],[32.98538,-96.69534],[32.98526,-96.68795],[32.98532,-96.68454],[32.98381,-96.57908],[32.98286,-96.51701],[32.98232,-96.51702],[32.97906,-96.51687],[32.9703,-96.51709],[32.96393,-96.51698],[32.92767,-96.51766],[32.92246,-96.5178],[32.91723,-96.51791],[32.91492,-96.51793],[32.91411,-96.51797],[32.90873,-96.51802],[32.90171,-96.51813],[32.90061,-96.51814],[32.90045,-96.51808],[32.89982,-96.51817],[32.89455,-96.51823],[32.8937,-96.51817],[32.8937,-96.51823],[32.89153,-96.51827],[32.89122,-96.51827],[32.89098,-96.51822],[32.89034,-96.51826],[32.88722,-96.51