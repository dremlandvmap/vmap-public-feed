{"styles":[{"sc":"#ff2600","so":1,"w":2,"ol":true,"fc":"#fffb00","fo":0.502}],"cards":["<div style=\"font-family:Helvetica,Arial,sans-serif;color:#222222;max-width:238px;\"><div style=\"background:#0e7d46;height:6px;border-radius:3px 3px 0 0;\"></div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:7px 0 0;\">COUNTY BOUNDARY</div><div style=\"font-size:10px;letter-spacing:.08em;color:#0e7d46;font-weight:700;text-transform:uppercase;padding:0 0 2px;\">NORTH CAROLINA</div><div style=\"font-size:16px;font-weight:800;padding:2px 0 6px;\">Lee County</div><table style=\"width:100%;border-collapse:collapse;font-size:12px;\"><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Population</td><td style=\"color:#111111;font-weight:600;\">70,000 (2025 est.)</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">County Seat</td><td style=\"color:#111111;font-weight:600;\">Sanford</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Land Area</td><td style=\"color:#111111;font-weight:600;\">255 sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Density</td><td style=\"color:#111111;font-weight:600;\">275 / sq mi</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Household Income</td><td style=\"color:#111111;font-weight:600;\">$65,000</td></tr><tr><td style=\"color:#666666;padding:3px 10px 3px 0;white-space:nowrap;\">Median Home Value</td><td style=\"color:#111111;font-weight:600;\">$240,000</td></tr></table><div style=\"font-size:12px;line-height:1.55;color:#333333;padding:8px 0 2px;border-top:1px solid #eef2f1;margin-top:7px;\">Lee County lies in the Sand Hills region midway between Raleigh and Fayetteville, its population and economy centered almost entirely on Sanford, the county seat, with small crossroads communities across the surrounding farmland. A large Pfizer sterile-injectables plant anchors local manufacturing, and spillover from the VinFast megasite under construction in neighboring Chatham County is pushing demand for industrial-zoned land along the US-1 and US-15-501 corridors.</div><div style=\"font-size:11px;color:#888888;padding-top:6px;\">Source: U.S. Census Bureau · Data verified: September 14, 2026</div></div>"],"feats":[["Lee County",0,[[35.41479,-79.07642],[35.35728,-79.13371],[35.35719,-79.13383],[35.30716,-79.18356],[35.30844,-79.1855],[35.30866,-79.18591],[35.30993,-79.1899],[35.31246,-79.19533],[35.31507,-79.20142],[35.32353,-79.21936],[35.32414,-79.22114],[35.32434,-79.22198],[35.33038,-79.23237],[35.33116,-79.23361],[35.34329,-79.25427],[35.34447,-79.26136],[35.34521,-79.2649],[35.34531,-79.26548],[35.34528,-79.26571],[35.3482,-79.26881],[35.35048,-79.27071],[35.3507,-79.27094],[35.35101,-79.27139],[35.35164,-79.27265],[35.35188,-79.27298],[35.35214,-79.27322],[35.35243,-79.2734],[35.35275,-79.27353],[35.35304,-79.27357],[35.35337,-79.27357],[35.36176,-79.27185],[35.36204,-79.27183],[35.36233,-79.27188],[35.36261,-79.272],[35.36286,-79.27218],[35.36528,-79.27471],[35.3655,-79.27489],[35.36581,-79.27508],[35.36971,-79.27632],[35.37008,-79.2764],[35.37661,-79.27704],[35.37691,-79.27712],[35.37723,-79.27729],[35.38149,-79.28044],[35.38596,-79.28386],[35.40044,-79.28956],[35.40032,-79.29003],[35.40039,-79.29023],[35.40047,-79.29066],[35.40055,-79.29167],[35.40051,-79.29187],[35.40042,-79.29201],[35.40016,-79.29228],[35.39984,-79.29285],[35.3998,-79.29304],[35.39974,-79.29321],[35.39963,-79.29339],[35.39958,-79.2936],[35.3996,-79.29397],[35.39978,-79.29415],[35.3999,-79.29439],[35.40006,-79.29452],[35.40028,-79.29481],[35.40085,-79.2957],[35.40129,-79.29603],[35.40147,-79.29657],[35.40149,-79.29678],[35.40162,-79.29715],[35.40184,-79.29735],[35.4018,-79.29788],[35.40201,-79.2983],[35.40205,-79.29856],[35.40219,-79.29874],[35.40228,-79.29898],[35.40241,-79.29919],[35.40279,-79.29955],[35.40297,-7